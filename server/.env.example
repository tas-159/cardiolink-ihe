# Copy to .env and adjust if needed. All values have safe defaults for local dev.
SECRET_KEY=dev-secret-change-me-cardiolink
ACCESS_TOKEN_EXPIRE_MINUTES=720
# SQLite by default; swap to PostgreSQL later with one line, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/cardiolink
DATABASE_URL=
# Comma-separated list, or * for any origin (dev)
CORS_ORIGINS=*
